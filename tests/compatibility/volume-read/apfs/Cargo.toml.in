[package]
name = "dmgez-apfs-volume-read-compatibility"
version = "0.0.0"
edition = "2024"
rust-version = "1.98"
publish = false

[dependencies]
# Workspace formats
dmgez-udif = { version = "=0.1.0", path = @dmgez-udif@, default-features = false, features = ["read", "write", "zlib"] }

# Workspace foundation
dmgez-vfs = { version = "=0.1.0", path = @dmgez-vfs@, default-features = false, features = ["zlib"] }

# Workspace adapters
dmgez-apfs = { version = "=0.1.0", path = @dmgez-apfs@, default-features = false }

# APFS libraries
apfs-container = { version = "=0.1.0", path = @apfs-container@, default-features = false }
apfs-core = { package = "libapfs-core", version = "=0.1.0", path = @libapfs-core@, default-features = false }
apfs-format = { version = "=0.1.0", path = @apfs-format@, default-features = false }
apfs-reader = { version = "=0.1.0", path = @apfs-reader@, default-features = false }

# Diagnostics
thiserror = "=2.0.21"

[dev-dependencies]
# Workspace runtime
dmgez-operations = { version = "=0.1.0", path = @dmgez-operations@, default-features = false, features = ["extract"] }

[target.'cfg(any(target_os = "linux", target_os = "macos"))'.dev-dependencies]
# Filesystem access and staging
tempfile = "=3.27.0"

[lints.rust]
unsafe_code = "forbid"
