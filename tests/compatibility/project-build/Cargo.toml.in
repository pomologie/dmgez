[package]
name = "dmgez-hfs-adapter-probe"
version = "0.0.0"
edition = "2024"
rust-version = "1.98"
publish = false

[features]
default = ["finder-write", "parallel"]
finder-write = ["dmgez-hfsplus/finder-write"]
lzma = ["dmgez-hfsplus/lzma", "dmgez-udif/lzma"]
parallel = ["dmgez-hfsplus/parallel"]
project-build = []
volume-icon = ["finder-write", "dmgez-hfsplus/volume-icon"]

[dependencies]
clap = { version = "=4.6.8", features = ["derive"] }
dmgez-builder = { path = @dmgez-builder@, default-features = false }
dmgez-config = { path = @dmgez-config@ }
dmgez-hfsplus = { path = @dmgez-hfsplus@, default-features = false }

[dev-dependencies]
dmgez-udif = { path = @dmgez-udif@, default-features = false, features = ["read", "zlib"] }
hfsplus-format = "=0.1.0"
rustix = { version = "1.1.6", features = ["fs"] }
tempfile = "=3.27.0"

[lints.rust]
unsafe_code = "forbid"
