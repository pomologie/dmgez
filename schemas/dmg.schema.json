{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dmgez draft configuration schema v1",
  "description": "Structural mirror only. Semantic path, feature, format, size, metadata, identity, and platform validation is required in the Rust project model. Recognized deferred fields do not imply implementation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "udro",
            "udzo",
            "ulfo",
            "ulmo",
            "raw",
            "udrw",
            "udsb",
            "sparseimage",
            "asif",
            "udbz",
            "udco"
          ]
        },
        "filesystem": {
          "enum": [
            "hfsplus",
            "hfsx",
            "apfs"
          ]
        },
        "size": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(B|KiB|MiB|GiB|TiB)$"
                }
              ]
            }
          ]
        },
        "shrink": {
          "type": "boolean"
        },
        "free_space": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(B|KiB|MiB|GiB|TiB)$"
            }
          ]
        },
        "partition": {
          "enum": [
            "none",
            "gpt",
            "apm",
            "mbr"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "output"
      ]
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "copy",
              "directory",
              "symlink"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "pattern": "^/[^\\x00]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "recursive": {
            "type": "boolean"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "hidden": {
            "type": "boolean"
          },
          "hide_extension": {
            "type": "boolean"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "custom_icon": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "symlink"
                }
              }
            },
            "then": {
              "required": [
                "destination",
                "target"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "recursive"
                    ]
                  },
                  {
                    "required": [
                      "include"
                    ]
                  },
                  {
                    "required": [
                      "exclude"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "directory"
                }
              }
            },
            "then": {
              "required": [
                "destination"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source"
                    ]
                  },
                  {
                    "required": [
                      "target"
                    ]
                  },
                  {
                    "required": [
                      "recursive"
                    ]
                  },
                  {
                    "required": [
                      "include"
                    ]
                  },
                  {
                    "required": [
                      "exclude"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "type"
                    ]
                  }
                },
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "copy"
                    }
                  }
                }
              ]
            },
            "then": {
              "required": [
                "source"
              ],
              "not": {
                "required": [
                  "target"
                ]
              }
            }
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "strict",
            "report"
          ]
        },
        "sidecar": {
